{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "typescript"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}"],
      "env": { "vitest": true }
    },
    {
      "files": ["scripts/**"],
      "env": { "node": true }
    },
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["../host/*", "../client/*", "../components/*", "../storage/*", "../lib/*", "../session*", "@/*", "react", "react-dom", "motion", "motion/*"],
            "message": "The engine runs anywhere, a server included: it can't depend on the host, the client, the UI or storage."
          }]
        }]
      }
    },
    {
      "files": ["src/host/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["../client/*", "../components/*", "../storage/*", "../lib/*", "../session*", "@/*", "react", "react-dom", "motion", "motion/*"],
            "message": "The host is meant to move onto a server as it is: it can't depend on the client, the UI or storage."
          }]
        }]
      }
    }
  ]
}
